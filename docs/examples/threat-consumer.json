        "signals": [
          {
            "id": "spam-lexicon",
            "kind": "lexicon",
            "weight": 1.0,
            "terms": [
              "enlargement", "viagra", "cialis", "crypto giveaway",
              "double your", "lottery win", "lottery prize",
